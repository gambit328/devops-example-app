localhost, devops-example.test {
        tls internal

        handle /images/* {
                file_server
                root * /app/public
            }

        handle {
                reverse_proxy app:3000 {
                        @error status 502
                        handle_response @error {
                                file_server
                                root * /app/services/caddy/views/error_pages
                                rewrite * /502.html
                            }
                    }
            }

        log {
                format json
            }
    }
